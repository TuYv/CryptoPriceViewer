{
  "name": "crypto-price-viewer",
  "description": "Chrome extension: crypto prices at a glance, a pinned price on the toolbar, and a crypto news timeline.",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "check": "tsc --noEmit && biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "e2e": "wxt build && playwright test",
    "postinstall": "wxt prepare",
    "store:images": "wxt build && playwright test --config scripts/playwright.store.config.ts",
    "icons": "node scripts/render-icons.mjs"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "5.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/chrome": "0.3.5",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@wxt-dev/module-react": "1.2.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.3",
    "web-ext": "10.7.0",
    "wxt": "0.21.4"
  }
}
